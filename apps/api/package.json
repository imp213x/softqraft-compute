{
  "name": "@softqraft/compute-api",
  "version": "0.1.0",
  "private": true,
  "description": "SoftQraft Compute control plane API.",
  "license": "UNLICENSED",
  "author": "SoftQraft Labs Ltd.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "test:pg": "tsx --test 'test/**/*.pg-test.ts'"
  },
  "dependencies": {
    "@softqraft/compute-contracts": "workspace:*",
    "@softqraft/compute-driver": "workspace:*",
    "@softqraft/compute-jobs": "workspace:*",
    "@softqraft/federation": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.4",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@softqraft/federation",
  "version": "1.0.0",
  "description": "SoftQraft Service Federation: cloud-federation-v1 signing, verification, grants, return paths, session policy, roles and conformance vectors.",
  "private": true,
  "license": "UNLICENSED",
  "author": "SoftQraft Labs Ltd.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vectors/cloud-federation-v1.vectors.json": "./vectors/cloud-federation-v1.vectors.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vectors",
    "scripts/verify-vendored.mjs",
    "tsconfig.build.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.nonstrict.json",
    "test": "node --import tsx --test test/*.test.ts",
    "vectors:check": "tsx scripts/generate-vectors.ts --check",
    "check": "npm run typecheck && npm run vectors:check && npm test",
    "sync": "node scripts/sync.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

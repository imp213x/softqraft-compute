# Compose release selection only. This file must not contain secrets.
# Copy it to /etc/softqraft/compute/deployment.env on SQ-CLOUD-01 (docs/deploy.md).

SOFTQRAFT_COMPUTE_IMAGE_REPOSITORY=softqraft/compute
SOFTQRAFT_COMPUTE_IMAGE_TAG=replace-with-the-full-reviewed-git-commit
SOFTQRAFT_COMPUTE_ENV_FILE=/etc/softqraft/compute/runtime.env

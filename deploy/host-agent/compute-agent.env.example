# /etc/softqraft/compute-agent.env: SoftQraft Compute host agent.
# Names only, apart from the two safe starting values below. Copy to
# /etc/softqraft/compute-agent.env (owner root, mode 0600) and fill in the
# values on the host. Never put values in git or a ticket.

# --- Compute API and this host
COMPUTE_API_URL=
COMPUTE_HOST_NAME=
# One-time token from Ops -> Fleet -> New enrolment token. Remove it after the
# first start (the agent logs when it was used).
COMPUTE_ENROLMENT_TOKEN=
COMPUTE_HOST_CAPACITY_VCPU=
COMPUTE_HOST_CAPACITY_MEMORY_MB=
COMPUTE_HOST_CAPACITY_DISK_GB=

# --- Agent behaviour. Blank lines take the defaults (docs/host-agent.md).
# Dry run first (decision F8): jobs are verified and the Proxmox writes are
# logged, never sent. Set false only on the go-live step.
COMPUTE_AGENT_DRY_RUN=true
# false (decision F4): the founder builds templates 9000 and 9001 by hand and
# the token stays limited to the pool. The agent then only checks that both
# templates exist, and refuses create jobs (templates_missing) until they do.
COMPUTE_AGENT_ENSURE_IMAGES=false
COMPUTE_AGENT_STATE_DIR=
COMPUTE_AGENT_NETWORK_GUARD_FILE=
COMPUTE_PILOT_CIDR=
COMPUTE_PRODUCTION_CIDR=
COMPUTE_PRODUCTION_BRIDGE=
LOG_LEVEL=

# --- Proxmox (runbook section 4). The token secret is pasted here by the
# founder, straight from `pveum user token add`.
PROXMOX_URL=
PROXMOX_NODE=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# The certificate pveproxy serves: pveproxy-ssl.pem if present, else pve-ssl.pem.
# Read it with `pvenode cert info` (docs/host-agent.md, "Re-pin after a certificate change").
PROXMOX_TLS_FINGERPRINT=
PROXMOX_POOL=
PROXMOX_STORAGE=
PROXMOX_IMPORT_STORAGE=
PROXMOX_BRIDGE=
COMPUTE_VMID_RANGE=
PROXMOX_NAMESERVERS=
PROXMOX_CI_USER=
PROXMOX_SHUTDOWN_TIMEOUT_SECONDS=
# Disk limits set on every pilot VM (reads and writes each), whole numbers.
# Defaults 100 MB/s (1-1000) and 2000 IOPS (10-50000).
COMPUTE_VM_DISK_MBPS=
COMPUTE_VM_DISK_IOPS=

# softqraft-compute API configuration. Placeholders only: never put real
# values in this file. Copy to .env (git-ignored) for local runs.

# --- Server
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
# This service's public origin. Launch URLs point here, and browser writes
# must carry it as Origin. Must be https in production with federation on.
COMPUTE_PUBLIC_URL=
# Secure flag on session cookies. Defaults to true when COMPUTE_PUBLIC_URL is https.
# false is refused unless COMPUTE_PUBLIC_URL is empty or http://localhost / http://127.0.0.1.
COMPUTE_COOKIE_SECURE=
# Comma-separated proxy IPs or CIDRs whose X-Forwarded-For is trusted (rate limits and the
# agent allow-list use the client IP). In the Compose deployment: the softqraft-edge subnet.
COMPUTE_TRUSTED_PROXY_CIDRS=
# Comma-separated IPs or CIDRs that may call the host-agent routes (enrolment and /v1/agent/*):
# the hosts' public IPs. Empty allows any IP; required in production with federation on.
COMPUTE_AGENT_ALLOWED_IPS=

# --- Store: postgres (default) or memory (local runs and tests only; refused in production)
COMPUTE_STORE=postgres
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/compute

# --- Pilot pool caps (decision D5) and allowed projects (decision D4)
COMPUTE_POOL_MAX_VCPU=4
COMPUTE_POOL_MAX_MEMORY_MB=8192
COMPUTE_POOL_MAX_INSTANCES=3
COMPUTE_POOL_MAX_DISK_GB=120
# Comma-separated Cloud project UUIDs, checked through each service
# instance's project. Empty means no project may create anything.
COMPUTE_ALLOWED_PROJECTS=
# Disk for a create request that leaves diskGb out (10 to 120).
COMPUTE_DEFAULT_DISK_GB=16
# The one region this deployment serves; §3.1 provisioning must name it.
COMPUTE_REGION_ID=eu-central
# How long POST /console/v1/instances/:id/console waits for the agent's ticket.
COMPUTE_CONSOLE_WAIT_SECONDS=15

# --- Private network for pilot instances. Must not overlap 10.20.0.0/24 (production).
COMPUTE_PILOT_CIDR=10.30.0.0/24

# --- Jobs. The signing key is an Ed25519 PKCS#8 PEM, held in env only.
COMPUTE_JOB_SIGNING_KEY_PEM=
COMPUTE_JOB_SIGNING_KEY_ID=job-1
COMPUTE_JOB_MAX_ATTEMPTS=3
COMPUTE_JOB_LEASE_SECONDS=120
COMPUTE_JOB_ENVELOPE_TTL_SECONDS=300
COMPUTE_MAINTENANCE_INTERVAL_SECONDS=15

# --- SoftQraft Cloud federation (cloud-federation-v1, audience "compute")
CLOUD_FEDERATION_ENABLED=false
# JSON object of { "<keyId>": "<SPKI PEM>" }: Cloud's public keys.
CLOUD_FEDERATION_PUBLIC_KEYS=
# Operator launch (§8) and the staff fleet routes under /admin/v1. Needs federation on.
CLOUD_OPERATOR_LAUNCH_ENABLED=false
# SoftQraft Cloud's origin. "Sign in again" on the Console goes to <CLOUD_ORIGIN>/cloud/open/compute,
# and on the staff fleet to <CLOUD_ORIGIN>/dashboard/services. Required (https) in production with federation on.
CLOUD_ORIGIN=
# Where the fleet's "Add a host" dialog links for the runbook steps (https). Has a default.
COMPUTE_HOST_RUNBOOK_URL=

# softqraft-compute API configuration. Placeholders only: never put real
# values in this file. Copy to .env (git-ignored) for local runs.

# --- Server
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# --- Store: postgres (default) or memory (local runs and tests only; refused in production)
COMPUTE_STORE=postgres
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/compute

# --- Pilot pool caps (decision D5) and allowed projects (decision D4)
COMPUTE_POOL_MAX_VCPU=4
COMPUTE_POOL_MAX_MEMORY_MB=8192
COMPUTE_POOL_MAX_INSTANCES=3
COMPUTE_POOL_MAX_DISK_GB=120
# Comma-separated Cloud project UUIDs. Empty means no project may create anything.
COMPUTE_ALLOWED_PROJECTS=

# --- Private network for pilot instances. Must not overlap 10.20.0.0/24 (production).
COMPUTE_PILOT_CIDR=10.30.0.0/24

# --- Jobs. The signing key is an Ed25519 PKCS#8 PEM, held in env only.
COMPUTE_JOB_SIGNING_KEY_PEM=
COMPUTE_JOB_SIGNING_KEY_ID=job-1
COMPUTE_JOB_MAX_ATTEMPTS=3
COMPUTE_JOB_LEASE_SECONDS=120
COMPUTE_JOB_ENVELOPE_TTL_SECONDS=300
COMPUTE_ENROLMENT_TOKEN_TTL_SECONDS=3600
COMPUTE_MAINTENANCE_INTERVAL_SECONDS=15

# --- SoftQraft Cloud federation (cloud-federation-v1, audience "compute")
CLOUD_FEDERATION_ENABLED=false
# JSON object of { "<keyId>": "<SPKI PEM>" }: Cloud's public keys.
CLOUD_FEDERATION_PUBLIC_KEYS=
